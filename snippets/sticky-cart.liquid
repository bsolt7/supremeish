<div id="sticky-cart">
  <div class="cart-header">
    <strong><span id="cart-count">0</span> item<span id="cart-s">s</span> in cart</strong>
  </div>
  <div class="cart-subtotal">
    subtotal: <span id="cart-subtotal-amount">$0.00</span>
  </div>
  <a href="/cart" class="view-cart-btn">View/Edit Cart</a>
  <a href="/checkout" class="checkout-btn">Checkout Now</a>
</div>

<!-- Sticky Cart Styles -->
<style>
#sticky-cart {
  position: fixed;
  top: 100px;
  left: 120px; /* <-- moved right to avoid sidebar */
  width: 200px;
  background: white;
  border: 1px solid #ccc;
  z-index: 9999;
  font-family: Courier, monospace;
  font-size: 12px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  padding-bottom: 10px;
  opacity: 0;
  transform: translateY(-10px);
  pointer-events: none;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

/* Inside sticky cart */
#sticky-cart .cart-header,
#sticky-cart .cart-subtotal {
  background: #e0e0e0;
  padding: 10px;
  border-bottom: 1px solid #ccc;
}

/* View/Edit Cart button */
.view-cart-btn {
  display: block;
  background: black;
  color: white;
  text-decoration: none;
  padding: 10px;
  margin: 10px;
  text-transform: uppercase;
  font-size: 12px;
  transition: all 0.3s ease;
}

.view-cart-btn:hover {
  background: white;
  color: black;
  border: 1px solid black;
}

/* Checkout button */
.checkout-btn {
  display: block;
  background: red;
  color: white;
  text-decoration: none;
  padding: 10px;
  margin: 10px;
  text-transform: uppercase;
  font-size: 12px;
  transition: all 0.3s ease;
}

.checkout-btn:hover {
  background: white;
  color: red;
  border: 1px solid red;
}

/* 🔥 Responsive Adjustments */
@media (max-width: 768px) {
  #sticky-cart {
    left: 20px;
    width: 90%;
    top: 80px;
  }
}

@media (min-width: 769px) and (max-width: 1024px) {
  #sticky-cart {
    left: 150px;
  }
}

@media (min-width: 1400px) {
  #sticky-cart {
    left: 300px;
  }
}
</style>

<!-- Sticky Cart JS -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function updateStickyCart() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const stickyCart = document.getElementById('sticky-cart');
        const cartCount = document.getElementById('cart-count');
        const cartSubtotalAmount = document.getElementById('cart-subtotal-amount');
        const cartS = document.getElementById('cart-s');

        if (cart && cart.item_count > 0) {
          cartCount.textContent = cart.item_count;
          cartSubtotalAmount.textContent = `$${(cart.total_price / 100).toFixed(2)}`;
          stickyCart.style.opacity = '1';
          stickyCart.style.transform = 'translateY(0)';
          stickyCart.style.pointerEvents = 'auto';
          cartS.style.display = cart.item_count > 1 ? 'inline' : 'none';
        } else {
          stickyCart.style.opacity = '0';
          stickyCart.style.transform = 'translateY(-10px)';
          stickyCart.style.pointerEvents = 'none';
        }
      })
      .catch(error => console.error('Sticky cart update error:', error));
  }

  // Initial update
  updateStickyCart();

  // Manual Event Listener for AJAX Add to Cart Success
  document.addEventListener('cart:updated', function() {
    updateStickyCart();
  });

});
</script>
