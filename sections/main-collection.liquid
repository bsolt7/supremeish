{% comment %}Main full page collection view — consistent with grid-only version{% endcomment %}
<section class="collection-grid-wrapper" id="ProductGridWrapper">
  <div id="ProductGrid" class="collection-grid">

    {% for product in collection.products %}
      <div class="collection-product-card">
        <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
          <div class="collection-product-title">
            {{ product.title }}
          </div>
          <div style="margin-top: 4px; font-size: 13px; font-weight: bold; font-family: Courier, monospace;">
            {{ product.price | money_without_trailing_zeros }}
          </div>
        </a>
      </div>
    {% endfor %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sidebarLinks = document.querySelectorAll('#Sidebar a');
  const productGrid = document.getElementById('ProductGrid');
  const mobileMenuButton = document.getElementById('mobile-menu-button');

  function updateMobileMenuTitle(title) {
    if (mobileMenuButton && title) {
      mobileMenuButton.innerHTML = `${title} \u25BC`;
    }
  }

  const activeInit = document.querySelector('#Sidebar a.active');
  if (activeInit) {
    updateMobileMenuTitle(activeInit.textContent.trim());
  }

  function loadCollection(url, skipPushState = false) {
    const fetchUrl = url + '?view=grid-only';
    productGrid.classList.add('fade-out');

    fetch(fetchUrl)
      .then(response => response.text())
      .then(data => {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = data;
        const newGrid = tempDiv.querySelector('#ProductGrid');

        if (newGrid) {
          setTimeout(() => {
            productGrid.innerHTML = newGrid.innerHTML;
            productGrid.classList.remove('fade-out');
            productGrid.classList.add('fade-in');
            setTimeout(() => productGrid.classList.remove('fade-in'), 500);

            if (!skipPushState) {
              window.history.pushState({}, '', url);
            }

            sidebarLinks.forEach(a => a.classList.remove('active'));
            sidebarLinks.forEach(a => {
              if (a.getAttribute('href') === url) {
                a.classList.add('active');
                updateMobileMenuTitle(a.textContent.trim());
              }
            });
          }, 300);
        }
      })
      .catch(error => {
        console.error('Error loading products:', error);
      });
  }

  sidebarLinks.forEach(link => {
    link.addEventListener('click', function(event) {
      event.preventDefault();
      const url = link.getAttribute('href');
      loadCollection(url);
    });
  });

  window.addEventListener('popstate', function() {
    loadCollection(window.location.pathname, true);
  });
});
</script>

{% schema %}
{
  "name": "Main Collection",
  "settings": [],
  "presets": [
    {
      "name": "Main Collection"
    }
  ]
}
{% endschema %}
