{% schema %}
{
  "name": "Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Enter"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ]
}
{% endschema %}

<div style="text-align: center; padding: 40px 20px;">
  {% if section.settings.banner_image %}
    <img src="{{ section.settings.banner_image | image_url: width: 800 }}" style="max-width: 400px; width: 100%; height: auto; margin-bottom: 20px;">
  {% endif %}
  
  {% if section.settings.button_label and section.settings.button_link %}
    <a href="{{ section.settings.button_link }}" style="display: inline-block; margin-top: 20px; background: black; color: white; padding: 10px 20px; text-transform: uppercase; font-size: 14px; letter-spacing: 1px;">{{ section.settings.button_label }}</a>
  {% endif %}
</div>
