<section class="product-page" style="max-width: 1200px; margin: 40px auto; padding: 20px; display: flex; flex-wrap: nowrap; align-items: flex-start; gap: 40px;">

  <!-- LEFT: Big Product Image -->
  <div class="product-left" style="flex: 0 0 50%; display: flex; justify-content: center;">
    <div class="zoom-wrapper" style="position: relative; max-width: 500px;">
      <a id="main-image-link" href="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 1600 }}" data-lightbox="product-images">
        <img 
          id="main-product-image"
          src="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
          class="zoom-image"
          style="width: 100%; height: auto;" />
      </a>
    </div>
  </div>

  <!-- RIGHT: Thumbnails + Info -->
  <div class="product-right" style="flex: 0 0 50%; display: flex; flex-direction: row; gap: 20px;">

    <!-- Thumbnails -->
    <div class="product-thumbnails" aria-label="Available colors">
      {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
      {% unless color_option %}
        {% assign color_option = product.options_with_values | where: 'name', 'Colour' | first %}
      {% endunless %}
      {% if color_option %}
        {% assign color_index = color_option.position | minus: 1 %}
        {% for value in color_option.values %}
          {% assign color_variant = nil %}
          {% for variant in product.variants %}
            {% if variant.options[color_index] == value and color_variant == nil %}
              {% assign color_variant = variant %}
            {% endif %}
          {% endfor %}
          {% assign color_media = color_variant.featured_media | default: product.featured_media %}
          <button
            type="button"
            class="color-swatch{% if color_variant.id == product.selected_or_first_available_variant.id or product.selected_or_first_available_variant.options[color_index] == value %} is-selected{% endif %}"
            data-color-value="{{ value | escape }}"
            data-option-position="{{ color_option.position }}"
            {% if color_media %}
              data-full="{{ color_media.preview_image | image_url: width: 800 }}"
              data-zoom="{{ color_media.preview_image | image_url: width: 1600 }}"
              style="--swatch-image: url('{{ color_media.preview_image | image_url: width: 120 }}')"
            {% endif %}
            aria-label="Select {{ color_option.name | escape }}: {{ value | escape }}"
            aria-pressed="false"
            title="{{ value | escape }}">
            <span class="visually-hidden">{{ value }}</span>
          </button>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="product-info" style="display: flex; flex-direction: column; gap: 10px; max-width: 400px;">

      <h1 style="font-size: 22px; font-weight: 600; margin: 0; text-transform: uppercase;">
        {{ product.title }}
      </h1>

      <!-- 🎯 Dynamic color output -->
      <p id="selected-color-text" style="font-size: 14px; font-weight: bold; text-transform: uppercase; margin: 0;">
        {% if color_option %}{{ product.selected_or_first_available_variant.options[color_index] }}{% endif %}
      </p>

      <p id="product-price" style="font-size: 16px; font-weight: bold; margin: 5px 0;">
        {{ product.selected_or_first_available_variant.price | money }}
      </p>

      <div style="font-size: 12px; color: #000000;">
        {{ product.description }}
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        <!-- Dropdowns -->
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {% for option in product.options_with_values %}
            <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 5px;">
              <label style="font-size: 12px;">{{ option.name }}</label>
              <select class="single-option-selector" name="options[{{ option.name }}]" data-option-position="{{ option.position }}">
                {% for value in option.values %}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>

        <!-- Buttons -->
        <div style="display: flex; gap: 10px; margin-top: 10px;">
          <button type="submit" class="product-button" style="flex: 1;">Add to Cart</button>
          <a href="/collections/all" class="product-button" style="flex: 1;">Keep Shopping</a>
        </div>

      {% endform %}

      <div id="product-variant-data" hidden>
        {% for variant in product.variants %}
          <span data-variant-id="{{ variant.id }}" data-options="{{ variant.options | json | escape }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}"{% if variant.featured_media %} data-full="{{ variant.featured_media.preview_image | image_url: width: 800 }}" data-zoom="{{ variant.featured_media.preview_image | image_url: width: 1600 }}"{% endif %}></span>
        {% endfor %}
      </div>

    </div>

  </div>

</section>

<!-- 🛒 Sticky Cart -->
{% render 'sticky-cart' %}

<!-- Local Styles -->
<style>
/* Product Buttons */
.product-button {
  background: black;
  color: white;
  text-transform: uppercase;
  padding: 12px 0;
  font-size: 12px;
  letter-spacing: 1px;
  text-decoration: none;
  border: 1px solid black;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}
.product-button:hover {
  background: white;
  color: black;
  border: 1px solid black;
}

/* Custom Dropdown */
.single-option-selector {
  width: 150px;
  padding: 8px 10px;
  font-size: 13px;
  border: 1px solid black;
  border-radius: 4px;
  background: transparent;
  font-family: Courier, monospace;
  text-transform: lowercase;
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,<svg fill='black' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 10px center;
  background-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.single-option-selector:hover {
  background-color: black;
  color: white;
}

.product-thumbnails {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 10px;
  width: 70px;
}
.color-swatch {
  width: 60px;
  height: 60px;
  padding: 0;
  border: 1px solid #aaa;
  background: #eee var(--swatch-image) center / cover no-repeat;
  cursor: pointer;
}
.color-swatch:hover,
.color-swatch:focus-visible {
  border-color: #000;
}
.color-swatch.is-selected {
  border: 3px solid #000;
  box-shadow: 0 0 0 2px #fff inset;
}
.visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const page = document.querySelector('.product-page');
    if (!page) return;

    const selectors = Array.from(page.querySelectorAll('.single-option-selector'));
    const swatches = Array.from(page.querySelectorAll('.color-swatch'));
    const variants = Array.from(page.querySelectorAll('#product-variant-data [data-variant-id]')).map(function (node) {
      return {
        id: node.dataset.variantId,
        options: JSON.parse(node.dataset.options),
        price: node.dataset.price,
        available: node.dataset.available === 'true',
        full: node.dataset.full,
        zoom: node.dataset.zoom
      };
    });
    const variantInput = page.querySelector('#variant-id');
    const price = page.querySelector('#product-price');
    const image = page.querySelector('#main-product-image');
    const imageLink = page.querySelector('#main-image-link');
    const colorText = page.querySelector('#selected-color-text');
    const addButton = page.querySelector('button[type="submit"]');

    function selectedOptions() {
      return selectors.map(function (selector) { return selector.value; });
    }

    function selectVariant(preferredSwatch) {
      const options = selectedOptions();
      const variant = variants.find(function (item) {
        return item.options.every(function (value, index) { return value === options[index]; });
      });
      const colorSelector = selectors.find(function (selector) {
        return preferredSwatch && selector.dataset.optionPosition === preferredSwatch.dataset.optionPosition;
      }) || selectors.find(function (selector) {
        return swatches[0] && selector.dataset.optionPosition === swatches[0].dataset.optionPosition;
      });

      swatches.forEach(function (swatch) {
        const active = colorSelector && swatch.dataset.colorValue === colorSelector.value;
        swatch.classList.toggle('is-selected', active);
        swatch.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (colorText && colorSelector) colorText.textContent = colorSelector.value;

      if (!variant) {
        if (addButton) {
          addButton.disabled = true;
          addButton.textContent = 'Unavailable';
        }
        return;
      }

      variantInput.value = variant.id;
      price.textContent = variant.price;
      if (addButton) {
        addButton.disabled = !variant.available;
        addButton.textContent = variant.available ? 'Add to Cart' : 'Sold Out';
      }

      const activeSwatch = swatches.find(function (swatch) { return swatch.classList.contains('is-selected'); });
      const full = variant.full || (activeSwatch && activeSwatch.dataset.full);
      const zoom = variant.zoom || (activeSwatch && activeSwatch.dataset.zoom);
      if (full && image) image.src = full;
      if (zoom && imageLink) imageLink.href = zoom;
      window.history.replaceState({}, '', window.location.pathname + '?variant=' + variant.id);
    }

    swatches.forEach(function (swatch) {
      swatch.addEventListener('click', function () {
        const selector = selectors.find(function (item) {
          return item.dataset.optionPosition === swatch.dataset.optionPosition;
        });
        if (!selector) return;
        selector.value = swatch.dataset.colorValue;
        selector.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
    selectors.forEach(function (selector) {
      selector.addEventListener('change', function () { selectVariant(); });
    });
    selectVariant();
  });
</script>
