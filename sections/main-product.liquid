{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_media = current_variant.featured_media | default: product.featured_media %}
{% assign thumbnail_option_index = 0 %}
{% assign thumbnail_option_name = product.options_with_values.first.name %}
{% for option in product.options_with_values %}
  {% assign normalized_option_name = option.name | downcase %}
  {% if normalized_option_name == 'color' or normalized_option_name == 'colour' or normalized_option_name == 'style' %}
    {% assign thumbnail_option_index = forloop.index0 %}
    {% assign thumbnail_option_name = option.name %}
    {% break %}
  {% endif %}
{% endfor %}

<section class="product-page">
  <div class="product-left">
    <div class="product-gallery">
      <div class="zoom-wrapper">
        <a id="main-image-link" href="{{ current_media.preview_image | image_url: width: 1600 }}" data-lightbox="product-images">
          <img
            id="main-product-image"
            src="{{ current_media.preview_image | image_url: width: 800 }}"
            alt="{{ current_media.alt | default: product.title | escape }}"
            class="zoom-image"
            width="800"
            height="{{ 800 | divided_by: current_media.preview_image.aspect_ratio | round }}">
        </a>
      </div>

    </div>
  </div>

  <div class="product-right">
    <div class="product-info">
      <h1>{{ product.title }}</h1>

      <p id="selected-color-text">{{ current_variant.options[thumbnail_option_index] }}</p>
      <p id="product-price">{{ current_variant.price | money }}</p>

      <div class="product-description">{{ product.description }}</div>

      {% form 'product', product %}
        <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

        <div class="product-options">
          {% for option in product.options_with_values %}
            <div class="product-option">
              <label for="ProductOption-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
              <select id="ProductOption-{{ section.id }}-{{ forloop.index0 }}" class="single-option-selector" name="options[{{ option.name }}]">
                {% for value in option.values %}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>

        <div class="product-thumbnails" aria-label="{{ thumbnail_option_name | escape }} images">
          {% for option_value in product.options_with_values[thumbnail_option_index].values %}
            <div class="thumbnail-column" data-option-value="{{ option_value | escape }}">
              {% assign rendered_media_ids = '|' %}
              {% assign rendered_media_count = 0 %}

              {% for variant in product.variants %}
                {% if variant.options[thumbnail_option_index] == option_value and variant.featured_media %}
                  {% assign media_token = variant.featured_media.id | append: '|' | prepend: '|' %}
                  {% unless rendered_media_ids contains media_token %}
                    {% assign rendered_media_ids = rendered_media_ids | append: variant.featured_media.id | append: '|' %}
                    {% assign rendered_media_count = rendered_media_count | plus: 1 %}
                    {% render 'product-thumbnail', media: variant.featured_media, option_value: option_value, option_name: thumbnail_option_name, option_index: thumbnail_option_index, is_active: false %}
                  {% endunless %}
                {% endif %}
              {% endfor %}

              {% assign normalized_option_value = option_value | downcase | strip %}
              {% for media in product.media %}
                {% assign normalized_media_alt = media.alt | downcase | strip %}
                {% comment %}
                  Associate any number of media items with a style by starting their alt text
                  with the option value. A pipe permits an accessible description, for example
                  "Black | Back view"; alt text containing only "Black" remains supported.
                {% endcomment %}
                {% assign media_style_tag = normalized_media_alt | split: '|' | first | strip %}
                {% assign media_token = media.id | append: '|' | prepend: '|' %}
                {% if media_style_tag == normalized_option_value %}
                  {% unless rendered_media_ids contains media_token %}
                    {% assign rendered_media_ids = rendered_media_ids | append: media.id | append: '|' %}
                    {% assign rendered_media_count = rendered_media_count | plus: 1 %}
                    {% render 'product-thumbnail', media: media, option_value: option_value, option_name: thumbnail_option_name, option_index: thumbnail_option_index, is_active: false %}
                  {% endunless %}
                {% endif %}
              {% endfor %}

              {% if rendered_media_count == 0 %}
                {% render 'product-thumbnail', media: current_media, option_value: option_value, option_name: thumbnail_option_name, option_index: thumbnail_option_index, is_active: false %}
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="product-actions">
          <button type="submit" class="product-button">Add to Cart</button>
          <a href="/collections/all" class="product-button">Keep Shopping</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% render 'sticky-cart' %}
