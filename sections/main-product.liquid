<section class="product-page" style="max-width: 1200px; margin: 40px auto; padding: 20px; display: flex; flex-wrap: nowrap; align-items: flex-start; gap: 40px;">

  <!-- LEFT: Big Product Image -->
  <div class="product-left" style="flex: 0 0 50%; display: flex; justify-content: center;">
    <div class="zoom-wrapper" style="position: relative; max-width: 500px;">
      <a id="main-image-link" href="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 1600 }}" data-lightbox="product-images">
        <img 
          id="main-product-image"
          src="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
          class="zoom-image"
          style="width: 100%; height: auto;" />
      </a>
    </div>
  </div>

  <!-- RIGHT: Thumbnails + Info -->
  <div class="product-right" style="flex: 0 0 50%; display: flex; flex-direction: row; gap: 20px;">

    <!-- Thumbnails -->
    <div class="product-thumbnails" style="display: flex; flex-direction: column; gap: 10px;">
      {% assign handled_colors = '' %}
      {% for option in product.options_with_values %}
        {% if option.name == 'Color' %}
          {% for value in option.values %}
            {% unless handled_colors contains value %}
              {% assign handled_colors = handled_colors | append: value | append: ',' %}
              <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 15px;">
                {% assign color_handle = value | handleize %}
                {% for media in product.media %}
                  {% assign media_handle = media.src | split: '/' | last | remove: '.jpg' | remove: '.png' | remove: '.jpeg' | handleize %}
                  {% if media_handle contains color_handle %}
                    <img 
                      src="{{ media.preview_image | image_url: width: 150 }}"
                      data-full="{{ media.preview_image | image_url: width: 800 }}"
                      data-zoom="{{ media.preview_image | image_url: width: 1600 }}"
                      data-color="{{ value }}"
                      class="thumbnail"
                      alt="{{ value }}"
                      style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;" />
                  {% endif %}
                {% endfor %}
              </div>
            {% endunless %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>

    <!-- Product Info -->
    <div class="product-info" style="display: flex; flex-direction: column; gap: 10px; max-width: 400px;">

      <h1 style="font-size: 22px; font-weight: 600; margin: 0; text-transform: uppercase;">
        {{ product.title }}
      </h1>

      {% assign selected_color = '' %}
      {% for option in product.options_with_values %}
        {% assign option_name = option.name | downcase %}
        {% if option_name == 'color' %}
          {% assign selected_color = option.selected_value %}
        {% endif %}
      {% endfor %}

      <!-- 🎯 Dynamic color output -->
      <p id="selected-color-text" style="font-size: 14px; font-weight: bold; text-transform: uppercase; margin: 0;">
        {{ selected_color }}
      </p>

      <p id="product-price" style="font-size: 16px; font-weight: bold; margin: 5px 0;">
        {{ product.selected_or_first_available_variant.price | money }}
      </p>

      <div style="font-size: 12px; color: #000000;">
        {{ product.description }}
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        <!-- Dropdowns -->
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {% for option in product.options_with_values %}
            <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 5px;">
              <label style="font-size: 12px;">{{ option.name }}</label>
              <select class="single-option-selector" name="options[{{ option.name }}]">
                {% for value in option.values %}
                  <option value="{{ value }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>

        <!-- Buttons -->
        <div style="display: flex; gap: 10px; margin-top: 10px;">
          <button type="submit" class="product-button" style="flex: 1;">Add to Cart</button>
          <a href="/collections/all" class="product-button" style="flex: 1;">Keep Shopping</a>
        </div>

      {% endform %}

    </div>

  </div>

</section>

<!-- 🛒 Sticky Cart -->
{% render 'sticky-cart' %}

<!-- Local Styles -->
<style>
/* Product Buttons */
.product-button {
  background: black;
  color: white;
  text-transform: uppercase;
  padding: 12px 0;
  font-size: 12px;
  letter-spacing: 1px;
  text-decoration: none;
  border: 1px solid black;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}
.product-button:hover {
  background: white;
  color: black;
  border: 1px solid black;
}

/* Custom Dropdown */
.single-option-selector {
  width: 150px;
  padding: 8px 10px;
  font-size: 13px;
  border: 1px solid black;
  border-radius: 4px;
  background: transparent;
  font-family: Courier, monospace;
  text-transform: lowercase;
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,<svg fill='black' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 10px center;
  background-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.single-option-selector:hover {
  background-color: black;
  color: white;
}
</style>
