{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_media = current_variant.featured_media | default: product.featured_media %}
{% assign thumbnail_option_index = 0 %}
{% assign thumbnail_option_name = product.options_with_values.first.name %}
{% for option in product.options_with_values %}
  {% assign normalized_option_name = option.name | downcase %}
  {% if normalized_option_name == 'color' or normalized_option_name == 'colour' or normalized_option_name == 'style' %}
    {% assign thumbnail_option_index = forloop.index0 %}
    {% assign thumbnail_option_name = option.name %}
    {% break %}
  {% endif %}
{% endfor %}

<section class="product-page">
  <div class="product-left">
    <div class="product-gallery">
      <div class="zoom-wrapper">
        <a id="main-image-link" href="{{ current_media.preview_image | image_url: width: 1600 }}" data-lightbox="product-images">
          <img
            id="main-product-image"
            src="{{ current_media.preview_image | image_url: width: 800 }}"
            alt="{{ current_media.alt | default: product.title | escape }}"
            class="zoom-image"
            width="800"
            height="{{ 800 | divided_by: current_media.preview_image.aspect_ratio | round }}">
        </a>
      </div>

      <div class="product-thumbnails" aria-label="{{ thumbnail_option_name | escape }} options">
        {% assign handled_values = '|' %}
        {% for variant in product.variants %}
          {% assign option_value = variant.options[thumbnail_option_index] %}
          {% assign value_token = option_value | append: '|' | prepend: '|' %}
          {% unless handled_values contains value_token %}
            {% assign handled_values = handled_values | append: option_value | append: '|' %}
            {% assign variant_media = variant.featured_media | default: current_media %}
            <button
              type="button"
              class="thumbnail{% if current_variant.options[thumbnail_option_index] == option_value %} is-active{% endif %}"
              data-option-index="{{ thumbnail_option_index }}"
              data-option-value="{{ option_value | escape }}"
              data-variant-id="{{ variant.id }}"
              data-full="{{ variant_media.preview_image | image_url: width: 800 }}"
              data-zoom="{{ variant_media.preview_image | image_url: width: 1600 }}"
              aria-label="Select {{ thumbnail_option_name | escape }}: {{ option_value | escape }}"
              aria-pressed="{% if current_variant.options[thumbnail_option_index] == option_value %}true{% else %}false{% endif %}">
              <img
                src="{{ variant_media.preview_image | image_url: width: 160, height: 160, crop: 'center' }}"
                alt="{{ option_value | escape }}"
                width="72"
                height="72"
                loading="lazy">
            </button>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="product-right">
    <div class="product-info">
      <h1>{{ product.title }}</h1>

      <p id="selected-color-text">{{ current_variant.options[thumbnail_option_index] }}</p>
      <p id="product-price">{{ current_variant.price | money }}</p>

      <div class="product-description">{{ product.description }}</div>

      {% form 'product', product %}
        <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

        <div class="product-options">
          {% for option in product.options_with_values %}
            <div class="product-option">
              <label for="ProductOption-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
              <select id="ProductOption-{{ section.id }}-{{ forloop.index0 }}" class="single-option-selector" name="options[{{ option.name }}]">
                {% for value in option.values %}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>

        <div class="product-actions">
          <button type="submit" class="product-button">Add to Cart</button>
          <a href="/collections/all" class="product-button">Keep Shopping</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% render 'sticky-cart' %}
