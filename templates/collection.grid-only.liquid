{% comment %}Template for AJAX-loaded collection grid only view{% endcomment %}
<section class="collection-grid-wrapper" id="ProductGridWrapper">
  <div id="ProductGrid" class="collection-grid">

    {% for product in collection.products %}
      <div class="collection-product-card">
        <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
          <div class="collection-product-title">
            {{ product.title }}
          </div>
          <div style="margin-top: 4px; font-size: 13px; font-weight: bold; font-family: Courier, monospace;">
            {{ product.price | money_without_trailing_zeros }}
          </div>
        </a>
      </div>
    {% endfor %}

  </div>
</section>
