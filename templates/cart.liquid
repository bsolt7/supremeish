{% layout 'theme' %}

<section style="max-width: 900px; margin: 40px auto; padding: 20px; font-family: Courier, monospace; font-size: 13px; border: 1px dotted black;">

  <h1 style="text-transform: lowercase; font-weight: normal; text-align: center; margin-bottom: 30px; padding-bottom: 10px; border-bottom: 1px dotted black;">
    your cart
  </h1>

  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" novalidate style="padding: 20px;">
      <table class="cart-table" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr class="cart-row" style="border-bottom: 1px dotted black;">
            <th style="text-align: left; padding: 10px;">Product</th>
            <th style="text-align: center;">Qty</th>
            <th style="text-align: right;">Price</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
          <tr class="cart-row" style="border-bottom: 1px dotted black;">
            <td class="cart-item-info" style="padding: 15px 10px; display: flex; align-items: center; gap: 15px;">
              <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}" style="width: 130px; height: auto;">
              <div style="line-height: 1.8;">
                <a href="{{ item.url }}" style="text-decoration: none; color: black; font-size: 15px;">{{ item.product.title }}</a><br>
                <small style="font-size: 13px;">Style: {{ item.variant.title }}</small>
              </div>
            </td>

            <td class="cart-item-qty" style="text-align: center;">
              <div style="display: flex; align-items: center; gap: 8px; justify-content: center;">
                <!-- Quantity Dropdown -->
                <select name="updates[]" style="width: 70px; padding: 6px; border: 1px solid black; background: transparent; font-family: Courier, monospace; font-size: 13px; text-align: center;">
                  {% for i in (0..8) %}
                    <option value="{{ i }}" {% if item.quantity == i %}selected{% endif %}>
                      {{ i }}
                    </option>
                  {% endfor %}
                </select>

                <!-- Remove Button -->
                <a href="{{ item.url_to_remove }}" style="background: black; color: white; padding: 6px 12px; font-size: 11px; text-transform: uppercase; text-decoration: none; border: 1px solid black; display: inline-block;">
                  remove
                </a>
              </div>
            </td>

            <td class="cart-item-price" style="text-align: right; font-size: 15px;">
              {{ item.line_price | money }}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="border-top: 1px dotted black; margin-top: 30px; padding-top: 15px; text-align: right; font-size: 15px;">
        subtotal: <strong>{{ cart.total_price | money }}</strong>
      </div>

      <div style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
        <button type="submit" name="update" style="background: black; color: white; padding: 10px 20px; text-transform: uppercase; font-size: 12px; border: 1px solid black; cursor: pointer;">
          Update
        </button>
        <a href="/checkout" style="background: red; color: white; padding: 10px 20px; text-transform: uppercase; font-size: 12px; border: 1px solid red; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
          Checkout
        </a>
        <a href="/collections/all" style="background: black; color: white; padding: 10px 20px; text-transform: uppercase; font-size: 12px; border: 1px solid black; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
          Keep Shopping
        </a>
      </div>

    </form>

  {% else %}
  
    <p style="text-align: center; font-size: 14px;">your cart is currently empty.</p>
    <div style="margin-top: 20px; text-align: center;">
      <a href="/collections/all" style="background: black; color: white; padding: 10px 20px; text-transform: uppercase; font-size: 12px; border: 1px solid black; text-decoration: none; display: inline-block;">
        Keep Shopping
      </a>
    </div>

  {% endif %}

</section>
