<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>
</head>

<body style="margin: 0; padding: 0;">

  <script>
    window.initialCartCount = {{ cart.item_count | default: 0 }};
  </script>

  {% section 'header' %}

  {% if template contains 'collection' %}
    <div id="mobile-menu">
      <button id="mobile-menu-button">{{ collection.title | default: 'collections' }} &#x25BC;</button>
      <div id="mobile-menu-content">
        <ul>
          {% assign menu = linklists['sidebar-menu'] %}
          {% if menu.links.size > 0 %}
            {% for link in menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>
  {% endif %}

  <!-- 🔥 Main Layout Wrapper (Sidebar + Content) -->
  <main class="collection-page" style="display: flex; max-width: 1400px; margin: 0 auto; padding: 40px; gap: 40px;">
    {% if template contains 'collection' %}
      <!-- Sidebar (ONLY on collection pages) -->
      <div class="collection-sidebar" id="Sidebar">
        {% section 'sidebar-menu' %}
      </div>
    {% endif %}

    <!-- Main Content -->
    <div class="collection-grid-wrapper">
      {{ content_for_layout }}
    </div>
  </main>

  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}
  <!-- Sticky‑cart back‑navigation patch -->
  <script src="{{ 'sticky-cart-back-nav-fix.js' | asset_url }}" defer></script>
  <!-- Mini‑cart hover rebind patch -->
  <script src="{{ 'mini-cart-hover-rebind-patch.js' | asset_url }}" defer></script>

  {{ content_for_footer }}

  {% if template contains 'product' %}
    <!-- Product Page Scripts -->
    <script id="ProductJson-{{ product.id }}" type="application/json">
      {{ product | json }}
    </script>
    <script id="VariantMediaJson-{{ product.id }}" type="application/json">
      {
        {% for variant in product.variants %}
          "{{ variant.id }}": {% if variant.featured_media %}{
            "image": {{ variant.featured_media.preview_image | image_url: width: 800 | json }},
            "zoom": {{ variant.featured_media.preview_image | image_url: width: 1600 | json }}
          }{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const thumbnails = document.querySelectorAll('.thumbnail');
        const mainImage = document.getElementById('main-product-image');
        const mainImageLink = document.getElementById('main-image-link');
        const variantSelects = document.querySelectorAll('select[name^="options"]');
        const priceElement = document.getElementById('product-price');
        const idInput = document.getElementById('variant-id');
        const selectedStyle = document.getElementById('selected-color-text');
        const productData = JSON.parse(document.getElementById('ProductJson-{{ product.id }}').textContent);
        const variantMedia = JSON.parse(document.getElementById('VariantMediaJson-{{ product.id }}').textContent);
        const colorSelect = Array.from(variantSelects).find(select =>
          select.name.replace(/^options\[|\]$/g, '').toLowerCase() === 'color'
        );
        const otherSelects = [...variantSelects].filter(s => s !== colorSelect);
        const thumbnailOptionIndex = thumbnails[0] ? Number(thumbnails[0].dataset.optionIndex) : -1;
        const thumbnailSelect = thumbnailOptionIndex >= 0 ? variantSelects[thumbnailOptionIndex] : null;
        const wrapper = document.querySelector('.zoom-wrapper');
        const zoomImage = document.querySelector('.zoom-image');

        function formatMoney(cents) { return '$' + (cents / 100).toFixed(2); }
        function findMatchingVariant() {
          const selected = Array.from(variantSelects).map(s => s.value.trim());
          return productData.variants.find(v => v.options.every((o,i) => o === selected[i]));
        }
        function updateActiveThumbnail() {
          const selectedValue = thumbnailSelect ? thumbnailSelect.value : '';
          thumbnails.forEach(thumb => {
            const active = thumb.dataset.optionValue === selectedValue;
            thumb.classList.toggle('is-active', active);
            thumb.setAttribute('aria-pressed', String(active));
          });
        }
        function updateVariant() {
          const match = findMatchingVariant();
          if (match) {
            priceElement.textContent = formatMoney(match.price);
            idInput.value = match.id;
            updateImageForVariant(match);
          }
          updateSelectedStyleName();
          updateActiveThumbnail();
        }
        function updateSelectedStyleName(){ if(selectedStyle && thumbnailSelect) selectedStyle.textContent = thumbnailSelect.value; }
        function updateImageByStyle(val){
          if(!val) return;
          const thumb = Array.from(thumbnails).find(t => t.dataset.optionValue === val);
          if(thumb){
            mainImage.src = thumb.dataset.full;
            mainImageLink.href = thumb.dataset.zoom;
          }
        }
        function updateImageForVariant(variant) {
          const media = variantMedia[String(variant.id)];
          if (media) {
            mainImage.src = media.image;
            mainImageLink.href = media.zoom;
            return;
          }
          updateImageByStyle(thumbnailSelect && thumbnailSelect.value);
        }

        thumbnails.forEach(t => t.addEventListener('click', function(){
          const optionSelect = variantSelects[Number(t.dataset.optionIndex)];
          if (optionSelect) {
            optionSelect.value = t.dataset.optionValue;
            optionSelect.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            mainImage.src = t.dataset.full;
            mainImageLink.href = t.dataset.zoom;
          }
        }));

        otherSelects.forEach(s => s.addEventListener('change', updateVariant));

        if(colorSelect){
          colorSelect.addEventListener('change', function(){
            updateVariant();
          });
        }

        if(wrapper && zoomImage && window.matchMedia('(hover: hover)').matches) {
          wrapper.addEventListener('mousemove', e => {
            const rect = wrapper.getBoundingClientRect();
            const x = ((e.clientX - rect.left)/rect.width)*100;
            const y = ((e.clientY - rect.top)/rect.height)*100;
            zoomImage.style.transformOrigin = `${x}% ${y}%`;
          });
          wrapper.addEventListener('mouseleave', () => zoomImage.style.transformOrigin = 'center center');
        }
        updateVariant();
      });
    </script>
  {% endif %}

  {% render 'sticky-cart' %}

</body>
</html>
