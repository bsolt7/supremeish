<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>
</head>

<body style="margin: 0; padding: 0;">

  <script>
    window.initialCartCount = {{ cart.item_count | default: 0 }};
  </script>

  {% section 'header' %}

  <!-- 🔥 Main Layout Wrapper (Sidebar + Content) -->
  <main class="collection-page" style="display: flex; max-width: 1400px; margin: 0 auto; padding: 40px; gap: 40px;">
    {% if template contains 'collection' %}
      <!-- Sidebar (ONLY on collection pages) -->
      <div class="collection-sidebar" id="Sidebar">
        {% section 'sidebar-menu' %}
      </div>
    {% endif %}

    <!-- Main Content -->
    <div class="collection-grid-wrapper">
      {{ content_for_layout }}
    </div>
  </main>

  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}
  <!-- Sticky‑cart back‑navigation patch -->
  <script src="{{ 'sticky-cart-back-nav-patch.js' | asset_url }}" defer></script>
  <!-- Mini‑cart hover rebind patch -->
  <script src="{{ 'mini-cart-hover-rebind-patch.js' | asset_url }}" defer></script>

  {{ content_for_footer }}

  {% if template contains 'product' %}
    <!-- Product Page Scripts -->
    <script id="ProductJson-{{ product.id }}" type="application/json">
      {{ product | json }}
    </script>
    <script>
      /* existing product‑page JS unchanged */
      document.addEventListener('DOMContentLoaded', function() {
        const thumbnails = document.querySelectorAll('.thumbnail');
        const mainImage = document.getElementById('main-product-image');
        const mainImageLink = document.getElementById('main-image-link');
        const variantSelects = document.querySelectorAll('select[name^="options"]');
        const priceElement = document.getElementById('product-price');
        const idInput = document.getElementById('variant-id');
        const selectedColor = document.getElementById('selected-color-text');
        const productData = JSON.parse(document.getElementById('ProductJson-{{ product.id }}').textContent);
        const colorSelect = document.querySelector('select[name="options[Color]"]');
        const wrapper = document.querySelector('.zoom-wrapper');
        const zoomImage = document.querySelector('.zoom-image');

        function formatMoney(cents) { return '$' + (cents / 100).toFixed(2); }
        function findMatchingVariant() {
          const selected = Array.from(variantSelects).map(s => s.value.trim());
          return productData.variants.find(v => v.options.every((o,i) => o === selected[i]));
        }
        function updateVariant() {
          const match = findMatchingVariant();
          if(match){ priceElement.textContent = formatMoney(match.price); idInput.value = match.id; }
          updateColorName();
        }
        function updateColorName(){ if(selectedColor && colorSelect) selectedColor.textContent = colorSelect.value; }

        thumbnails.forEach(t => t.addEventListener('click', function(){
          mainImage.src = t.dataset.full;
          mainImageLink.href = t.dataset.zoom;
          const col = t.dataset.color;
          if(colorSelect && col) {
            [...colorSelect.options].forEach((o,i) => {
              if(o.value.toLowerCase().trim() === col.toLowerCase().trim()){
                colorSelect.selectedIndex = i;
                colorSelect.dispatchEvent(new Event('change',{bubbles:true}));
              }
            });
            updateColorName();
          }
        }));

        variantSelects.forEach(s => s.addEventListener('change', updateVariant));

        if(wrapper && zoomImage) {
          wrapper.addEventListener('mousemove', e => {
            const rect = wrapper.getBoundingClientRect();
            const x = ((e.clientX - rect.left)/rect.width)*100;
            const y = ((e.clientY - rect.top)/rect.height)*100;
            zoomImage.style.transformOrigin = `${x}% ${y}%`;
          });
          wrapper.addEventListener('mouseleave', () => zoomImage.style.transformOrigin = 'center center');
        }
        updateColorName();
      });
    </script>
  {% endif %}

  {% render 'sticky-cart' %}

</body>
</html>
