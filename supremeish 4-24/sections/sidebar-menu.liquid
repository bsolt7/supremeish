<div id="Sidebar" class="sidebar-menu {{ section.settings.font_choice }}">

  <ul style="list-style: none; padding: 10px; margin: 0;">
    {% assign sidebar_menu = linklists['sidebar-menu'] %}
    {% if sidebar_menu.links.size > 0 %}
      {% for link in sidebar_menu.links %}
        <li style="margin: 10px 0;">
          <a href="{{ link.url }}"
             class="{% if link.url == request.path %}active{% endif %}"
             style="text-decoration: none; font-size: 12px; text-transform: lowercase; padding: 6px 12px; display: inline-block; transition: all 0.3s ease; border-radius: 2px;">
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    {% else %}
      <li>No menu items found.</li>
    {% endif %}
  </ul>
  
</div>

{% schema %}
{
  "name": "Sidebar Menu",
  "settings": [
    {
      "type": "select",
      "id": "font_choice",
      "label": "Font Style",
      "options": [
        { "value": "courier", "label": "Courier New (Supreme Classic)" },
        { "value": "ibm-plex-mono", "label": "IBM Plex Mono (Modern Mono)" },
        { "value": "space-mono", "label": "Space Mono (Bold Streetwear)" },
        { "value": "roboto-mono", "label": "Roboto Mono (Clean Modern)" }
      ],
      "default": "courier"
    }
  ],
  "presets": [
    {
      "name": "Sidebar Menu"
    }
  ]
}
{% endschema %}
